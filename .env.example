# AI inference — OpenAI-compatible endpoint.
# The control plane talks to whatever is in these three variables. Nothing else
# in the codebase may hardcode a provider, a model, a host, or a key.
#
# DEV  (now)  : Groq
# PROD (kickoff): Vultr Serverless Inference — also OpenAI-compatible.
#   OPENAI_API_KEY=<vultr serverless inference key>
#   OPENAI_ENDPOINT=https://api.vultrinference.com/v1
#   OPENAI_MODEL=<vultr model id, e.g. MiniMaxAI/MiniMax-M2.7>

OPENAI_API_KEY=
OPENAI_ENDPOINT=
OPENAI_MODEL=

# Transport tuning
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2

# Control plane
PORT=8787

# Vite dev-server proxy target (server-side only; never reaches the browser bundle)
BRZ_API_TARGET=http://127.0.0.1:8787
NODE_ENV=development
