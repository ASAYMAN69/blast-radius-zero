{
  "name": "brz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Containment-first control plane for AI agents — plan, dispatch into isolated sandboxes, return verifiable output with a blast-radius report.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
